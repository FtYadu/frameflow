# Copy to .env (or export in your shell) and fill in real values.
DATABASE_URL=postgres://ubuntu:ubuntu@localhost:5432/frameflow
PORT=3000
JWT_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string

# Optional server-side provider fallbacks (users' own keys take priority)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
